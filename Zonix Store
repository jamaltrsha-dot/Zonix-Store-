(function(){let t=0;try{t=+localStorage.getItem("zx-join")||0}catch(e){}
  if(Date.now()-t>3*864e5)$("#joinModal").classList.add("active")})();
rerender();loadProducts();setInterval(loadProducts,120000);
setUser(SESS&&SESS.user?SESS.user:null);
