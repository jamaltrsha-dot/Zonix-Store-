const authToken=(body,grant)=>sbFetch("/auth/v1/token?grant_type="+grant,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
const toSess=j=>({access_token:j.access_token,refresh_token:j.refresh_token,expires_at:Date.now()+(j.expires_in||3600)*1000-60000,user:j.user});
async function getToken(){
  if(!SESS)return null;
  if(Date.now()>SESS.expires_at){
    const r=await authToken({refresh_token:SESS.refresh_token},"refresh_token");
    if(r.ok&&r.json&&r.json.access_token)saveSess(toSess(r.json));else{saveSess(null);return null}
  }
  return SESS.access_token;
}
const WA="963937584116";
const QR_SRC="qr.jpg";
const ROLES={customer:["زبون",0],merchant:["تاجر",1],vip:["تاجر VIP",2],agent:["وكيل",3]};
const SECTIONS=[["ألعاب","🎮","قسم الألعاب",215],["تطبيقات","📱","قسم التطبيقات",265],["اشتراكات","📺","قسم الاشتراكات",350],["رصيد","📞","قسم الرصيد",190],["بطاقات","🎁","قسم البطاقات",160],["توثيق حسابات","✅","قسم التوثيق",200]];
const CFG=JSON.parse($("#cfg").textContent);
let PCT=2,DATA=CFG.data,currentUser=null,role="customer",cat="",pick=null,prodIdx=null,BAL=null,TOPS=[],RATE=0,lastSig="";

function applyTheme(t){document.documentElement.setAttribute("data-theme",t)}
function curTheme(){return document.documentElement.getAttribute("data-theme")||(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light")}
function toggleTheme(){const t=curTheme()==="dark"?"light":"dark";applyTheme(t);try{localStorage.setItem("zx-theme",t)}catch(e){}}
try{const s=localStorage.getItem("zx-theme");if(s)applyTheme(s)}catch(e){}
$("#modeBtn").onclick=toggleTheme;$("#modeTop").onclick=toggleTheme;
if(QR_SRC){const q=$("#qrimg");q.src=QR_SRC;q.hidden=false}

const disc=()=>ROLES[role][1];
function base(k){if(!k[1])return null;const p=k[2]!=null?k[2]:PCT;return Math.ceil(k[1]*(1+p/100)*2)/2}
const fm=v=>v.toFixed(2).replace(/\.?0+$/,"")+"$";
function final(k){const b=base(k);return b==null?null:Math.round(b*(1-disc()/100)*100)/100}
const pTxt=k=>{const f=final(k);return f==null?"اسأل عن السعر":fm(f)};
function pHtml(k){const f=final(k);if(f==null)return "اسأل عن السعر";return disc()?`<s>${fm(base(k))}</s>${fm(f)}`:fm(f)}
function say(sel,t,ok){const e=$(sel);e.textContent=t;e.style.color=ok?"var(--green)":"#e5484d"}

async function rpc(fn,args){
  const t=await getToken();if(!t)return{ok:false,error:"سجّل الدخول من جديد"};
  const r=await sbFetch("/rest/v1/rpc/"+fn,{method:"POST",headers:{"Content-Type":"application/json",Authorization:"Bearer "+t},body:JSON.stringify(args||{})});
  if(!r.ok)return{ok:false,error:(r.json&&(r.json.message||r.json.error_description))||"تعذر الاتصال بالخادم"};
  return r.json;
}
async function api(action,data){
  if(action==="balance"){
    const r=await rpc("my_wallet");
    if(r&&r.ok)r.topups=(r.topups||[]).map(x=>({amount:x.usd,note:x.currency==="SYP"?Number(x.amount).toLocaleString("en")+" ل.س":"",txn:x.txn,status:"مستعمل"}));
    return r;
  }
  if(action==="topup")return rpc("redeem_txn",{p_txn:data.txn});
  if(action==="order"){
    if(!data.row)return{ok:false,error:"الأسعار لم تُحمَّل بعد، أعد تحميل الصفحة"};
    return rpc("place_order",{p_id:data.row,p_pid:data.player_id});
  }
  return{ok:false,error:"إجراء غير معروف"};
}
async function refreshBal(){
  if(!currentUser){BAL=null;TOPS=[];checkUser();renderWallet();return}
  try{const r=await api("balance",{name:currentUser.name});if(r.ok){BAL=r.balance;TOPS=r.topups||[];RATE=Number(r.rate)||0}}catch(e){}
  checkUser();renderWallet();
}
function renderWallet(){
  $("#balv").textContent=BAL==null?"—":fm(BAL);
  const rt=$("#rate");if(rt)rt.textContent=RATE>0?"سعر الصرف: 1$ = "+RATE.toLocaleString("en")+" ل.س":"";
  const t=$("#thist");t.textContent="";
  TOPS.forEach(x=>{const r=t.insertRow();r.insertCell().textContent=fm(Number(x.amount))+(x.note?" ("+x.note+")":"");r.insertCell().textContent=x.txn;r.insertCell().textContent=x.status})
}

function go(p){
  ["home","cat","cham","acc"].forEach(x=>$("#pg-"+x).hidden=x!==p);
  closeMenu();pick=null;$("#order").classList.remove("on");
  if(p==="acc")renderAcc();
  if(p==="cham"){if(!currentUser)openAuth();else refreshBal()}
  window.scrollTo(0,0);
}
function openMenu(){$("#dr").classList.add("on");$("#ov").classList.add("on")}
function closeMenu(){$("#dr").classList.remove("on");$("#ov").classList.remove("on")}
$("#mn").onclick=openMenu;$("#ov").onclick=closeMenu;
document.addEventListener("click",e=>{const g=e.target.closest("[data-go]");if(g)go(g.dataset.go)});

function tiles(){
  const extra=[...new Set(DATA.map(d=>d.c))].filter(c=>!SECTIONS.some(s=>s[0]===c)).map((c,i)=>[c,"🛒","قسم "+c,(i*47+30)%360]);
  $("#tiles").innerHTML=[...SECTIONS,...extra].map(([n,i,t,h])=>
   `<button class="tile" data-cat="${esc(n)}"><div class="art" style="--h:${h}"><i>${i}</i><b>${esc(t)}</b></div>${esc(n)}</button>`).join("");
}
function cards(list){
  return list.map(({d,i})=>`<div class="card"><h3>${esc(d.n)}</h3><small>${esc(d.u)}</small><div class="pkgs">`+
   d.p.map((k,j)=>`<button class="pkg" data-k="${i}-${j}" aria-pressed="false"><span>${esc(k[0])}</span><span>${pHtml(k)}</span></button>`).join("")+`</div></div>`).join("");
}
function catHtml(){
  const sec=SECTIONS.find(s=>s[0]===cat),ic=sec?sec[1]:"🛒";
  const L=DATA.map((d,i)=>({d,i})).filter(x=>x.d.c===cat);
  const g=$("#grid");g.className="tiles";
  g.innerHTML=L.length?L.map(({d,i})=>`<button class="tile" data-prod="${i}"><div class="art" style="--h:${(i*37+200)%360}"><i>${ic}</i><b>${esc(d.n)}</b></div>${esc(d.u)}</button>`).join(""):'<p class="empty">للاستفسار عن هذا القسم تواصل معنا عبر واتساب.</p>';
}
function prodCards(i){
  const d=DATA[i],G={},ord=[];
  d.p.forEach((k,j)=>{const n=k[3]||d.u||"الباقات";if(!G[n]){G[n]=[];ord.push(n)}G[n].push([k,j])});
  return ord.map(n=>`<div class="card"><h3>${esc(n)}</h3><small>${esc(d.n)}</small><div class="pkgs">`+
   G[n].map(([k,j])=>`<button class="pkg" data-k="${i}-${j}" aria-pressed="false"><span>${esc(k[0])}</span><span>${pHtml(k)}</span></button>`).join("")+`</div></div>`).join("");
}
function prodHtml(i){$("#ct").textContent=DATA[i].n;const g=$("#grid");g.className="grid";g.innerHTML=prodCards(i)}
function openCat(c){cat=c;prodIdx=null;$("#ct").textContent=c;catHtml();go("cat")}
function openProd(i){prodIdx=i;prodHtml(i);go("cat")}
$("#bk").onclick=()=>{prodIdx!=null?openCat(cat):go("home")};
function search(){
  const q=$("#sq").value.trim().toLowerCase(),r=$("#sres");
  $("#tiles").hidden=!!q;r.hidden=!q;if(!q)return;
  const L=DATA.map((d,i)=>({d,i})).filter(x=>(x.d.n+x.d.c+x.d.u).toLowerCase().includes(q));
  r.innerHTML=L.length?cards(L):'<p class="empty">لا نتائج</p>';
}
$("#sq").oninput=search;
document.addEventListener("click",e=>{
  const t=e.target.closest("[data-cat]");if(t)return openCat(t.dataset.cat);
  const pr=e.target.closest("[data-prod]");if(pr)return openProd(+pr.dataset.prod);
  const b=e.target.closest(".pkg");if(!b)return;
  pick=b.dataset.k;const[i,j]=pick.split("-"),d=DATA[i],k=d.p[j];
  document.querySelectorAll(".pkg").forEach(x=>x.setAttribute("aria-pressed",x===b));
  $("#sel").textContent=`${d.n} — ${k[0]} — ${pTxt(k)}`;$("#omsg").textContent="";$("#order").classList.add("on");
});
/* تحديث العرض بدون قفز للأعلى أو مسح الاختيار */
function rerender(){
  tiles();search();
  if(!$("#pg-cat").hidden){if(prodIdx!=null&&DATA[prodIdx])prodHtml(prodIdx);else{prodIdx=null;$("#ct").textContent=cat;catHtml()}}
  if(!$("#pg-acc").hidden)renderAcc();
  checkUser();
  if(pick){
    const[i,j]=pick.split("-"),d=DATA[i],k=d&&d.p[j];
    if(k){$("#sel").textContent=`${d.n} — ${k[0]} — ${pTxt(k)}`;const b=document.querySelector('.pkg[data-k="'+pick+'"]');if(b)b.setAttribute("aria-pressed","true")}
    else{pick=null;$("#order").classList.remove("on")}
  }
}

function openAuth(){$("#authModal").classList.add("active")}
function closeAuth(){$("#authModal").classList.remove("active")}
async function setUser(u){
  currentUser=u?{email:u.email,name:(u.user_metadata&&u.user_metadata.name)||u.email.split("@")[0]}:null;
  role="customer";
  if(currentUser){
    const r=await fetchRole(currentUser.email,currentUser.name);
    if(ROLES[r])role=r;
  }
  rerender();refreshBal();
}
async function fetchRole(){
  const t=await getToken();if(!t)return"customer";
  const r=await sbFetch("/rest/v1/zx_profiles?select=role",{headers:{Authorization:"Bearer "+t}});
  return r.ok&&Array.isArray(r.json)&&r.json[0]?r.json[0].role:"customer";
}
function checkUser(){
  const b=$("#userBadge");b.textContent="";
  if(currentUser){
    const s=document.createElement("span");s.textContent=currentUser.name;
    const c=document.createElement("span");c.className="chip";c.textContent=ROLES[role][0];
    b.append(s,c);
    if(BAL!=null){const w=document.createElement("span");w.className="chip";w.textContent="💰 "+fm(BAL);b.append(w)}
    closeAuth();
  }else{const x=document.createElement("button");x.className="btn sm wa";x.textContent="دخول";x.onclick=openAuth;b.append(x)}
  $("#dnm").textContent=currentUser?currentUser.name:"زائر";
  $("#dav").textContent=currentUser?currentUser.name.charAt(0).toUpperCase():"👤";
  $("#drl").textContent=ROLES[role][0];$("#dout").hidden=!currentUser;
}
function renderAcc(){
  const a=$("#accbox");a.textContent="";
  const h=document.createElement("h2");h.style.marginTop="0";h.textContent="حسابي";a.append(h);
  if(!currentUser){const b=document.createElement("button");b.className="btn";b.textContent="تسجيل الدخول";b.onclick=openAuth;a.append(b);return}
  const p=document.createElement("p");
  p.textContent=currentUser.name+" — "+currentUser.email;
  const c=document.createElement("span");c.className="chip";c.textContent=ROLES[role][0]+(disc()?" · خصم "+disc()+"%":"");
  p.append(" ",c);a.append(p);
  const t=document.createElement("table");
  Object.keys(ROLES).forEach(k=>{const r=t.insertRow();if(k===role)r.className="me";r.insertCell().textContent=ROLES[k][0];r.insertCell().textContent="خصم "+ROLES[k][1]+"%"});
  a.append(t);
  const l=document.createElement("a");l.className="btn wa";l.target="_blank";l.rel="noopener";
  l.href="https://wa.me/"+WA+"?text="+encodeURIComponent("مرحباً، أريد ترقية حسابي ("+currentUser.email+") إلى تاجر / تاجر VIP / وكيل");
  l.textContent="طلب ترقية الحساب";a.append(l);
}
async function handleAuth(){
  const name=$("#authName").value.trim(),email=$("#authEmail").value.trim(),pass=$("#authPass").value;
  if(!email.includes("@")||pass.length<6){alert("أدخل بريداً صحيحاً وكلمة سر لا تقل عن 6 أحرف");return}
  const em=j=>(j&&(j.error_description||j.msg||j.message))||"";
  try{
    let r=await authToken({email,password:pass},"password");
    if(!r.ok){
      if(/confirm/i.test(em(r.json))){alert("أكّد بريدك الإلكتروني من الرسالة التي وصلتك ثم سجّل الدخول");return}
      if(!name){alert("تحقق من البريد وكلمة السر. وإن كان هذا حساباً جديداً فاكتب اسمك أيضاً");return}
      const s=await sbFetch("/auth/v1/signup",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email,password:pass,data:{name}})});
      if(!s.ok){alert(/registered|exists/i.test(em(s.json))?"كلمة السر خاطئة لهذا البريد":(em(s.json)||"تعذر إنشاء الحساب"));return}
      if(!s.json||!s.json.access_token){alert("تم إنشاء الحساب. أكّد بريدك من الرسالة ثم سجّل الدخول");return}
      r=s;
    }
    saveSess(toSess(r.json));await setUser(SESS.user);
  }catch(e){alert("تعذر الاتصال بالخادم. تحقق من الإنترنت وأعد المحاولة")}
}
async function logout(){
  try{if(SESS)await sbFetch("/auth/v1/logout",{method:"POST",headers:{Authorization:"Bearer "+SESS.access_token}})}catch(e){}
  saveSess(null);closeMenu();await setUser(null)
}
$("#dout").onclick=logout;

$("#tsend").onclick=async()=>{
  if(!currentUser){openAuth();return}
  const txn=$("#ttx").value.trim();
  if(txn.length<4){say("#tmsg","أدخل رقم العملية",0);return}
  const b=$("#tsend");b.disabled=true;say("#tmsg","جارٍ الإرسال...",1);
  try{
    const r=await api("topup",{name:currentUser.name,txn});
    if(r.ok){$("#ttx").value="";say("#tmsg","تمت إضافة "+fm(r.added)+(r.note?" ("+r.note+")":"")+" إلى رصيدك ✅",1);refreshBal()}
    else say("#tmsg",r.error||"تعذر الإرسال",0);
  }catch(e){say("#tmsg","تعذر الاتصال بالخادم، حاول مرة أخرى",0)}
  b.disabled=false;
};

$("#send").onclick=async()=>{
  if(!pick)return;
  if(!currentUser){alert("سجّل الدخول أولاً لإرسال الطلب");openAuth();return}
  const[i,j]=pick.split("-"),d=DATA[i],k=d.p[j],id=$("#pid").value.trim();
  if(!id){$("#pid").focus();$("#pid").placeholder="الرجاء كتابة الـ ID أو رقم الخط أولاً";return}
  const rl=ROLES[role][0]+(disc()?" (خصم "+disc()+"%)":"");
  const wa=(extra)=>"https://wa.me/"+WA+"?text="+encodeURIComponent(`مرحباً Zonix Store، أريد طلب:\n${extra}الاسم: ${currentUser.name}\nالفئة: ${rl}\n${d.n} - ${k[0]}\nالسعر: ${pTxt(k)}\nالمعرف/الرقم: ${id}`);
  if(final(k)==null){window.open(wa("(استفسار عن السعر)\n"),"_blank");return}
  const w=window.open("","_blank"),btn=$("#send");
  btn.disabled=true;say("#omsg","جارٍ تنفيذ الطلب...",1);
  try{
    const r=await api("order",{row:k[4],player_id:id});
    if(r.ok){
      BAL=r.balance;checkUser();
      const u=wa("رقم الطلب: "+r.id+"\n(تم الخصم من الرصيد)\n");
      if(w)w.location.href=u;
      say("#omsg","تم الطلب ✅ رقم "+r.id+" — الرصيد المتبقي "+fm(r.balance)+" ",1);
      const a=document.createElement("a");a.href=u;a.target="_blank";a.rel="noopener";a.textContent="فتح واتساب";$("#omsg").append(a);
    }else{
      if(w)w.close();
      if(r.balance!=null){BAL=r.balance;checkUser()}
      say("#omsg",(r.error||"تعذر تنفيذ الطلب")+(r.price!=null?" — اشحن رصيدك من القائمة ثم أعد المحاولة":""),0);
    }
  }catch(e){if(w)w.close();say("#omsg","تعذر الاتصال بالخادم، لم يُخصم شيء. حاول مرة أخرى",0)}
  btn.disabled=false;
};

/* الأسعار والأقسام تُقرأ من Supabase (جدولا products و settings) */
async function loadProducts(){
  try{
    const H={Authorization:"Bearer "+SB_KEY};
    const[p,s]=await Promise.all([sbFetch("/rest/v1/products?select=*&order=sort",{headers:H}),sbFetch("/rest/v1/settings?select=value&key=eq.profit_pct",{headers:H})]);
    if(!p.ok||!Array.isArray(p.json)||!p.json.length)return;
    const v=s.json&&s.json[0]?parseFloat(s.json[0].value):NaN;if(v>=0)PCT=v;
    const m={},out=[];
    p.json.forEach(x=>{const key=x.section+"|"+x.product;
      if(!m[key]){m[key]={c:x.section,n:x.product,u:x.unit||"",p:[]};out.push(m[key])}
      m[key].p.push([x.package,Number(x.cost)||0,x.profit==null?null:Number(x.profit),x.unit||"",x.id])});
    const sig=JSON.stringify([PCT,out]);if(sig===lastSig)return;
    lastSig=sig;DATA=out;rerender();
  }catch(e){}
}
/* إشعار الانضمام للقناة والمجموعة: يظهر عند أول فتح، ثم مرة كل 3 أيام */
